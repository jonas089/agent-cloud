# agentcloud market. Every field is optional; these are the defaults.

listen = "127.0.0.1:8420"
data_dir = "data/market"          # database and escrow key
web_dir = "web/dist"              # the built web app
escrow_fee_utia = 500             # added to first payments; the escrow's charge, which pays its gas
poll_seconds = 6                  # how often the ledger reads new blocks
pending_seconds = 1800            # how long a reserved lease waits for its first payment
offline_after_seconds = 90        # an agent silent this long takes no new leases
repository = ""                   # git URL shown in the setup instructions

[chain]
chain_id = "mocha-5"
rest = "https://api.celestia-mocha.com"
rpc = "https://rpc.celestia-mocha.com"
denom = "utia"
bech32_prefix = "celestia"
gas_adjustment = 1.1              # headroom on simulated gas; gas and gas price come from the chain
explorer = "https://mocha.celenium.io"
